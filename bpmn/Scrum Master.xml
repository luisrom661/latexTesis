<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Defs_SM" targetNamespace="http://example.com/socialscrum/sm">

  <!-- MENSAJES -->
  <bpmn:message id="MSG_SPRINT_KICKOFF" name="Sprint Kickoff (PO→SM)"/>
  <bpmn:message id="MSG_SIGNALS_DAILY" name="Señales Sociales Diarias (SG→SM)"/>
  <bpmn:message id="MSG_ESCALATION_SG" name="Escalación Social (SG→SM)"/>
  <bpmn:message id="MSG_REVIEW_INVITE" name="Invitación Review (SM→PO/DEVs)"/>
  <bpmn:message id="MSG_RETRO_REPORT" name="Reporte para Retrospectiva (SG→SM)"/>

  <!-- COLABORACIÓN -->
  <bpmn:collaboration id="Collab_SM">
    <bpmn:participant id="Part_SM" name="Scrum Master" processRef="Proc_SM"/>
    <bpmn:participant id="Part_PO" name="Product Owner"/>
    <bpmn:participant id="Part_SG" name="Social Guide"/>
    <bpmn:participant id="Part_DEV" name="Developers"/>

    <bpmn:messageFlow id="MF_Kickoff" sourceRef="Ev_Kickoff" targetRef="Part_SM" messageRef="MSG_SPRINT_KICKOFF"/>
    <bpmn:messageFlow id="MF_Signals" sourceRef="Task_SM_RecibirSenales" targetRef="Part_SG" messageRef="MSG_SIGNALS_DAILY"/>
    <bpmn:messageFlow id="MF_Escalation" sourceRef="EvSub_Escalation" targetRef="Part_SG" messageRef="MSG_ESCALATION_SG"/>
    <bpmn:messageFlow id="MF_ReviewInvite_PO" sourceRef="Task_SM_InvitarReview" targetRef="Part_PO" messageRef="MSG_REVIEW_INVITE"/>
    <bpmn:messageFlow id="MF_ReviewInvite_DEV" sourceRef="Task_SM_InvitarReview" targetRef="Part_DEV" messageRef="MSG_REVIEW_INVITE"/>
    <bpmn:messageFlow id="MF_RetroReport" sourceRef="Ev_ReporteRetro" targetRef="Part_SG" messageRef="MSG_RETRO_REPORT"/>
  </bpmn:collaboration>

  <!-- PROCESO SM -->
  <bpmn:process id="Proc_SM" name="Orquestación Social del Sprint (SM)" isExecutable="false">

    <!-- EVENTO DE MENSAJE INICIO -->
    <bpmn:startEvent id="Ev_Kickoff" name="Kickoff recibido">
      <bpmn:messageEventDefinition messageRef="MSG_SPRINT_KICKOFF"/>
    </bpmn:startEvent>

    <!-- PREPARACIÓN EN PARALELO -->
    <bpmn:parallelGateway id="GW_Fork_Init"/>
    <bpmn:userTask id="Task_SM_Agenda" name="Diseñar agenda social del Sprint"/>
    <bpmn:userTask id="Task_SM_RiesgosBoard" name="Configurar tablero de riesgos sociales"/>
    <bpmn:parallelGateway id="GW_Join_Init"/>

    <!-- PLANNING -->
    <bpmn:callActivity id="Call_Planning" name="Facilitar Sprint Planning Social" calledElement="GLB_Planning_Social"/>
    <!-- SUBPROCESO DAILY MULTI-INSTANCE -->
    <bpmn:subProcess id="Sub_Daily" name="Ciclo Diario Social">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>5</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="Ev_Timer_Diario" name="08:45">
        <bpmn:timerEventDefinition><bpmn:timeCycle>R/PT24H</bpmn:timeCycle></bpmn:timerEventDefinition>
      </bpmn:startEvent>

      <bpmn:userTask id="Task_SM_Daily" name="Daily Social (facilitación)"/>
      <bpmn:receiveTask id="Task_SM_RecibirSenales" name="Recibir señales/insights (SG)">
        <bpmn:messageRef>MSG_SIGNALS_DAILY</bpmn:messageRef>
      </bpmn:receiveTask>

      <bpmn:exclusiveGateway id="GW_Impedimento" name="¿Impedimento social?"/>
      <bpmn:userTask id="Task_SM_RegistrarImp" name="Registrar &amp; priorizar impedimento"/>
      <bpmn:textAnnotation id="Note_Imp"><bpmn:text>Ej.: radio silence, silo, lone wolf</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_Imp" sourceRef="Task_SM_RegistrarImp" targetRef="Note_Imp"/>

      <bpmn:endEvent id="Ev_Daily_End" name="Fin día"/>

      <bpmn:sequenceFlow id="F_D1" sourceRef="Ev_Timer_Diario" targetRef="Task_SM_Daily"/>
      <bpmn:sequenceFlow id="F_D2" sourceRef="Task_SM_Daily" targetRef="Task_SM_RecibirSenales"/>
      <bpmn:sequenceFlow id="F_D3" sourceRef="Task_SM_RecibirSenales" targetRef="GW_Impedimento"/>
      <bpmn:sequenceFlow id="F_D4" sourceRef="GW_Impedimento" targetRef="Task_SM_RegistrarImp">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${true}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_D5" sourceRef="Task_SM_RegistrarImp" targetRef="Ev_Daily_End"/>
      <bpmn:sequenceFlow id="F_D6" sourceRef="GW_Impedimento" targetRef="Ev_Daily_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${false}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- EVENT SUB-PROCESS: ESCALACIÓN NO INTERRUPTIVA -->
      <bpmn:subProcess id="ESP_Escalation" name="Atender urgencia social" triggeredByEvent="true">
        <bpmn:startEvent id="EvSub_Escalation" name="Escalación (SG)">
          <bpmn:messageEventDefinition messageRef="MSG_ESCALATION_SG"/>
        </bpmn:startEvent>
        <bpmn:userTask id="Task_SM_Mediar" name="Mediación/coaching inmediato"/>
        <bpmn:endEvent id="EvSub_End"/>
        <bpmn:sequenceFlow id="F_ES1" sourceRef="EvSub_Escalation" targetRef="Task_SM_Mediar"/>
        <bpmn:sequenceFlow id="F_ES2" sourceRef="Task_SM_Mediar" targetRef="EvSub_End"/>
      </bpmn:subProcess>

    </bpmn:subProcess>

    <!-- REVIEW & RETRO -->
    <bpmn:sendTask id="Task_SM_InvitarReview" name="Enviar invitación Review">
      <bpmn:messageRef>MSG_REVIEW_INVITE</bpmn:messageRef>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_SM_FacilitarReview" name="Facilitar Sprint Review Social"/>

    <bpmn:boundaryEvent id="Ev_ReporteRetro" attachedToRef="Task_SM_FacilitarReview" cancelActivity="false" name="Reporte SG disponible">
      <bpmn:messageEventDefinition messageRef="MSG_RETRO_REPORT"/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_SM_PreRetro" name="Preparar Retrospectiva (insights del reporte)"/>

    <bpmn:callActivity id="Call_Retro" name="Facilitar Sprint Retrospective Social" calledElement="GLB_Retro_Social"/>

    <!-- ARTEFACTOS -->
    <bpmn:dataStoreReference id="DS_Riesgos" name="Tablero de riesgos sociales"/>
    <bpmn:association id="Assoc_Risk" sourceRef="Task_SM_RiesgosBoard" targetRef="DS_Riesgos"/>
    <bpmn:dataStoreReference id="DS_Improvements" name="Backlog de mejoras sociales"/>
    <bpmn:association id="Assoc_ImpStore" sourceRef="Call_Retro" targetRef="DS_Improvements"/>

    <bpmn:endEvent id="Ev_End" name="Cierre / Próximo Sprint"/>

    <!-- FLUJO PRINCIPAL -->
    <bpmn:sequenceFlow id="F1" sourceRef="Ev_Kickoff" targetRef="GW_Fork_Init"/>
    <bpmn:sequenceFlow id="F2" sourceRef="GW_Fork_Init" targetRef="Task_SM_Agenda"/>
    <bpmn:sequenceFlow id="F3" sourceRef="GW_Fork_Init" targetRef="Task_SM_RiesgosBoard"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_SM_Agenda" targetRef="GW_Join_Init"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_SM_RiesgosBoard" targetRef="GW_Join_Init"/>
    <bpmn:sequenceFlow id="F6" sourceRef="GW_Join_Init" targetRef="Call_Planning"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Call_Planning" targetRef="Sub_Daily"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Sub_Daily" targetRef="Task_SM_InvitarReview"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_SM_InvitarReview" targetRef="Task_SM_FacilitarReview"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_SM_FacilitarReview" targetRef="Task_SM_PreRetro"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_SM_PreRetro" targetRef="Call_Retro"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Call_Retro" targetRef="Ev_End"/>
  </bpmn:process>

  <!-- GLOBAL PROCESSES (Plantillas) -->
  <bpmn:process id="GLB_Planning_Social" name="Plantilla Planning Social"/>
  <bpmn:process id="GLB_Retro_Social" name="Plantilla Retrospectiva Social"/>

  <!-- DI -->
  <bpmndi:BPMNDiagram id="DI_SM">
    <bpmndi:BPMNPlane id="Plane_SM" bpmnElement="Collab_SM">
      <!-- Pools -->
      <bpmndi:BPMNShape id="DI_Part_SM" bpmnElement="Part_SM" isHorizontal="true"><dc:Bounds x="160" y="60" width="1820" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_PO" bpmnElement="Part_PO" isHorizontal="true"><dc:Bounds x="160" y="420" width="1820" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_SG" bpmnElement="Part_SG" isHorizontal="true"><dc:Bounds x="160" y="510" width="1820" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_DEV" bpmnElement="Part_DEV" isHorizontal="true"><dc:Bounds x="160" y="600" width="1820" height="80"/></bpmndi:BPMNShape>

      <!-- Nodes (SM pool) -->
      <bpmndi:BPMNShape id="DI_Ev_Kick" bpmnElement="Ev_Kickoff"><dc:Bounds x="190" y="190" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_Fork" bpmnElement="GW_Fork_Init"><dc:Bounds x="250" y="198" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Agenda" bpmnElement="Task_SM_Agenda"><dc:Bounds x="320" y="140" width="230" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Risk" bpmnElement="Task_SM_RiesgosBoard"><dc:Bounds x="320" y="240" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_Join" bpmnElement="GW_Join_Init"><dc:Bounds x="610" y="198" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Call_Planning" bpmnElement="Call_Planning"><dc:Bounds x="670" y="180" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Sub_Daily" bpmnElement="Sub_Daily"><dc:Bounds x="960" y="100" width="520" height="240"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Invite" bpmnElement="Task_SM_InvitarReview"><dc:Bounds x="1500" y="180" width="230" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Review" bpmnElement="Task_SM_FacilitarReview"><dc:Bounds x="1750" y="180" width="240" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_PreRetro" bpmnElement="Task_SM_PreRetro"><dc:Bounds x="2000" y="180" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Call_Retro" bpmnElement="Call_Retro"><dc:Bounds x="2270" y="180" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Ev_End" bpmnElement="Ev_End"><dc:Bounds x="2540" y="196" width="36" height="36"/></bpmndi:BPMNShape>

      <!-- Sub_Daily internals -->
      <bpmndi:BPMNShape id="DI_Ev_Time" bpmnElement="Ev_Timer_Diario"><dc:Bounds x="980" y="160" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Daily" bpmnElement="Task_SM_Daily"><dc:Bounds x="1030" y="140" width="210" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RecSig" bpmnElement="Task_SM_RecibirSenales"><dc:Bounds x="1255" y="140" width="210" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_Imp" bpmnElement="GW_Impedimento"><dc:Bounds x="1180" y="230" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RegImp" bpmnElement="Task_SM_RegistrarImp"><dc:Bounds x="1235" y="220" width="240" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Ev_Daily_End" bpmnElement="Ev_Daily_End"><dc:Bounds x="1485" y="236" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Note_Imp" bpmnElement="Note_Imp"><dc:Bounds x="1480" y="280" width="200" height="40"/></bpmndi:BPMNShape>

      <!-- Event SubProcess -->
      <bpmndi:BPMNShape id="DI_ESP" bpmnElement="ESP_Escalation"><dc:Bounds x="980" y="220" width="180" height="100"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_EvSub" bpmnElement="EvSub_Escalation"><dc:Bounds x="990" y="250" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Mediar" bpmnElement="Task_SM_Mediar"><dc:Bounds x="1035" y="240" width="110" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_EvSub_End" bpmnElement="EvSub_End"><dc:Bounds x="1155" y="256" width="28" height="28"/></bpmndi:BPMNShape>

      <!-- DataStores -->
      <bpmndi:BPMNShape id="DI_DS_Risk" bpmnElement="DS_Riesgos"><dc:Bounds x="370" y="310" width="50" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_DS_Imp" bpmnElement="DS_Improvements"><dc:Bounds x="2360" y="250" width="60" height="45"/></bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_F1" bpmnElement="F1"><di:waypoint x="226" y="208"/><di:waypoint x="250" y="218"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2" bpmnElement="F2"><di:waypoint x="290" y="218"/><di:waypoint x="320" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3" bpmnElement="F3"><di:waypoint x="290" y="218"/><di:waypoint x="320" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4" bpmnElement="F4"><di:waypoint x="550" y="170"/><di:waypoint x="610" y="218"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F5" bpmnElement="F5"><di:waypoint x="580" y="270"/><di:waypoint x="610" y="218"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F6" bpmnElement="F6"><di:waypoint x="650" y="218"/><di:waypoint x="670" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F7" bpmnElement="F7"><di:waypoint x="930" y="210"/><di:waypoint x="960" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F8" bpmnElement="F8"><di:waypoint x="1480" y="210"/><di:waypoint x="1500" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F9" bpmnElement="F9"><di:waypoint x="1730" y="210"/><di:waypoint x="1750" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F10" bpmnElement="F10"><di:waypoint x="1990" y="210"/><di:waypoint x="2000" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F11" bpmnElement="F11"><di:waypoint x="2260" y="210"/><di:waypoint x="2270" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F12" bpmnElement="F12"><di:waypoint x="2530" y="210"/><di:waypoint x="2540" y="214"/></bpmndi:BPMNEdge>

      <!-- Sub_Daily edges -->
      <bpmndi:BPMNEdge id="E_FD1" bpmnElement="F_D1"><di:waypoint x="1016" y="178"/><di:waypoint x="1030" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FD2" bpmnElement="F_D2"><di:waypoint x="1240" y="170"/><di:waypoint x="1255" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FD3" bpmnElement="F_D3"><di:waypoint x="1365" y="170"/><di:waypoint x="1200" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FD4" bpmnElement="F_D4"><di:waypoint x="1220" y="250"/><di:waypoint x="1235" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FD5" bpmnElement="F_D5"><di:waypoint x="1475" y="250"/><di:waypoint x="1485" y="254"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FD6" bpmnElement="F_D6"><di:waypoint x="1200" y="250"/><di:waypoint x="1485" y="254"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_AssocImp" bpmnElement="Assoc_Imp"><di:waypoint x="1370" y="280"/><di:waypoint x="1480" y="300"/></bpmndi:BPMNEdge>

      <!-- MessageFlows (render como edges) -->
      <bpmndi:BPMNEdge id="DI_MF_ReviewPO" bpmnElement="MF_ReviewInvite_PO"><di:waypoint x="1615" y="240"/><di:waypoint x="1700" y="460"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_MF_ReviewDEV" bpmnElement="MF_ReviewInvite_DEV"><di:waypoint x="1615" y="240"/><di:waypoint x="1700" y="650"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
