<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Defs_Master" targetNamespace="http://example.com/socialscrum/master">

  <!-- MENSAJES COMPARTIDOS -->
  <bpmn:message id="MSG_SPRINT_KICKOFF" name="Sprint Kickoff (PO→SM/DEVs)"/>
  <bpmn:message id="MSG_SIGNALS_DAILY" name="Señales Sociales (SG→SM/PO/DEVs)"/>
  <bpmn:message id="MSG_ESCALATION_SG" name="Escalación Social (SG→SM)"/>
  <bpmn:message id="MSG_REVIEW_INVITE" name="Invitación Review (SM→PO/DEVs)"/>
  <bpmn:message id="MSG_RETRO_REPORT" name="Reporte Retro (SG→SM)"/>
  <bpmn:message id="MSG_IMPEDIMENTO" name="Impedimento Social (SM→DEVs)"/>

  <!-- COLLABORATION con 4 Pools -->
  <bpmn:collaboration id="Collab_Master" name="SocialScrum - Orquestación Maestro">
    <bpmn:participant id="Part_PO" name="Product Owner" processRef="Proc_PO"/>
    <bpmn:participant id="Part_SM" name="Scrum Master" processRef="Proc_SM"/>
    <bpmn:participant id="Part_SG" name="Social Guide" processRef="Proc_SG"/>
    <bpmn:participant id="Part_DEV" name="Developers" processRef="Proc_DEV"/>

    <!-- Flujos de mensaje (inter-roles) -->
    <bpmn:messageFlow id="MF_1_PO_SM_Kickoff" sourceRef="Task_PO_AnunciarKickoff" targetRef="Ev_SM_Kickoff" messageRef="MSG_SPRINT_KICKOFF"/>
    <bpmn:messageFlow id="MF_2_PO_DEV_Kickoff" sourceRef="Task_PO_AnunciarKickoff" targetRef="Ev_DEV_Kickoff" messageRef="MSG_SPRINT_KICKOFF"/>

    <bpmn:messageFlow id="MF_3_SG_SM_Signals" sourceRef="Task_SG_EmitirSenales" targetRef="Task_SM_RecibirSenales" messageRef="MSG_SIGNALS_DAILY"/>
    <bpmn:messageFlow id="MF_4_SG_PO_Signals" sourceRef="Task_SG_EmitirSenales" targetRef="Ev_PO_Signals" messageRef="MSG_SIGNALS_DAILY"/>
    <bpmn:messageFlow id="MF_5_SG_DEV_Signals" sourceRef="Task_SG_EmitirSenales" targetRef="Task_DEV_RecibirSenales" messageRef="MSG_SIGNALS_DAILY"/>

    <bpmn:messageFlow id="MF_6_SG_SM_Escalation" sourceRef="Task_SG_Escalar" targetRef="EvSub_SM_Escalation" messageRef="MSG_ESCALATION_SG"/>

    <bpmn:messageFlow id="MF_7_SM_PO_ReviewInvite" sourceRef="Task_SM_InvitarReview" targetRef="Ev_PO_ReviewInvite" messageRef="MSG_REVIEW_INVITE"/>
    <bpmn:messageFlow id="MF_8_SM_DEV_ReviewInvite" sourceRef="Task_SM_InvitarReview" targetRef="Ev_DEV_ReviewInvite" messageRef="MSG_REVIEW_INVITE"/>

    <bpmn:messageFlow id="MF_9_SG_SM_RetroReport" sourceRef="Task_SG_EnviarReporte" targetRef="Ev_SM_RetroReport" messageRef="MSG_RETRO_REPORT"/>

    <bpmn:messageFlow id="MF_10_SM_DEV_Impedimento" sourceRef="Task_SM_NotificarImpedimento" targetRef="BE_DEV_Impedimento" messageRef="MSG_IMPEDIMENTO"/>
  </bpmn:collaboration>

  <!-- Proceso: PRODUCT OWNER -->
  <bpmn:process id="Proc_PO" name="PO - Gestión de Valor Social" isExecutable="false">
    <bpmn:startEvent id="Ev_PO_Start" name="Preparación Sprint"/>
    <bpmn:dataStoreReference id="DS_PB_Social" name="Product Backlog Social"/>
    <bpmn:userTask id="Task_PO_Priorizar" name="Priorizar/ordenar PB Social"/>
    <bpmn:association id="Assoc_PO_PB" sourceRef="Task_PO_Priorizar" targetRef="DS_PB_Social"/>
    <bpmn:userTask id="Task_PO_DefObjetivo" name="Definir Objetivo + Riesgos Sociales"/>
    <bpmn:exclusiveGateway id="GW_PO_Capacidad" name="¿Capacidad/alcance válido?"/>
    <bpmn:userTask id="Task_PO_Rescope" name="Rescope/Repriorizar"/>
    <bpmn:sendTask id="Task_PO_AnunciarKickoff" name="Anunciar Sprint (SM/DEVs)">
      <bpmn:messageRef>MSG_SPRINT_KICKOFF</bpmn:messageRef>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Ev_PO_Signals" name="Señales SG (durante Sprint)">
      <bpmn:messageRef>MSG_SIGNALS_DAILY</bpmn:messageRef>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_PO_Ajustar" name="Ajustar PB/Riesgos (si aplica)"/>

    <bpmn:receiveTask id="Ev_PO_ReviewInvite" name="Invitación Review (SM)">
      <bpmn:messageRef>MSG_REVIEW_INVITE</bpmn:messageRef>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_PO_Review" name="Participar en Review Social"/>
    <bpmn:endEvent id="Ev_PO_End" name="Cierre PO"/>

    <bpmn:sequenceFlow id="PO_F1" sourceRef="Ev_PO_Start" targetRef="Task_PO_Priorizar"/>
    <bpmn:sequenceFlow id="PO_F2" sourceRef="Task_PO_Priorizar" targetRef="Task_PO_DefObjetivo"/>
    <bpmn:sequenceFlow id="PO_F3" sourceRef="Task_PO_DefObjetivo" targetRef="GW_PO_Capacidad"/>
    <bpmn:sequenceFlow id="PO_F4" sourceRef="GW_PO_Capacidad" targetRef="Task_PO_Rescope">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${false}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PO_F5" sourceRef="Task_PO_Rescope" targetRef="Task_PO_DefObjetivo"/>
    <bpmn:sequenceFlow id="PO_F6" sourceRef="GW_PO_Capacidad" targetRef="Task_PO_AnunciarKickoff">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${true}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PO_F7" sourceRef="Task_PO_AnunciarKickoff" targetRef="Ev_PO_Signals"/>
    <bpmn:sequenceFlow id="PO_F8" sourceRef="Ev_PO_Signals" targetRef="Task_PO_Ajustar"/>
    <bpmn:sequenceFlow id="PO_F9" sourceRef="Task_PO_Ajustar" targetRef="Ev_PO_ReviewInvite"/>
    <bpmn:sequenceFlow id="PO_F10" sourceRef="Ev_PO_ReviewInvite" targetRef="Task_PO_Review"/>
    <bpmn:sequenceFlow id="PO_F11" sourceRef="Task_PO_Review" targetRef="Ev_PO_End"/>
  </bpmn:process>

  <!-- Proceso: SCRUM MASTER -->
  <bpmn:process id="Proc_SM" name="SM - Orquestación Social" isExecutable="false">
    <bpmn:startEvent id="Ev_SM_Kickoff" name="Kickoff recibido">
      <bpmn:messageEventDefinition messageRef="MSG_SPRINT_KICKOFF"/>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="GW_SM_Fork"/>
    <bpmn:userTask id="Task_SM_Agenda" name="Diseñar agenda social"/>
    <bpmn:userTask id="Task_SM_RiesgosBoard" name="Configurar tablero de riesgos sociales"/>
    <bpmn:parallelGateway id="GW_SM_Join"/>
    <bpmn:userTask id="Task_SM_Planning" name="Facilitar Sprint Planning Social"/>

    <!-- Subproceso diario -->
    <bpmn:subProcess id="Sub_SM_Daily" name="Ciclo Diario Social">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>5</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Ev_SM_Timer" name="08:45">
        <bpmn:timerEventDefinition><bpmn:timeCycle>R/PT24H</bpmn:timeCycle></bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_SM_Daily" name="Daily Social (facilitar)"/>
      <bpmn:receiveTask id="Task_SM_RecibirSenales" name="Recibir señales (SG)">
        <bpmn:messageRef>MSG_SIGNALS_DAILY</bpmn:messageRef>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="GW_SM_Imped" name="¿Impedimento?"/>
      <bpmn:userTask id="Task_SM_NotificarImpedimento" name="Notificar impedimento a DEVs">
        <bpmn:incoming>F_SM_I1</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="Ev_SM_Daily_End" name="Fin día"/>

      <bpmn:sequenceFlow id="F_SM_D1" sourceRef="Ev_SM_Timer" targetRef="Task_SM_Daily"/>
      <bpmn:sequenceFlow id="F_SM_D2" sourceRef="Task_SM_Daily" targetRef="Task_SM_RecibirSenales"/>
      <bpmn:sequenceFlow id="F_SM_D3" sourceRef="Task_SM_RecibirSenales" targetRef="GW_SM_Imped"/>
      <bpmn:sequenceFlow id="F_SM_D4" sourceRef="GW_SM_Imped" targetRef="Task_SM_NotificarImpedimento" id="F_SM_I1">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${true}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_SM_D5" sourceRef="Task_SM_NotificarImpedimento" targetRef="Ev_SM_Daily_End"/>
      <bpmn:sequenceFlow id="F_SM_D6" sourceRef="GW_SM_Imped" targetRef="Ev_SM_Daily_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${false}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- Event Sub-Process: escalación SG -->
      <bpmn:subProcess id="ESP_SM_Esc" name="Atender escalación" triggeredByEvent="true">
        <bpmn:startEvent id="EvSub_SM_Escalation" name="Escalación (SG)">
          <bpmn:messageEventDefinition messageRef="MSG_ESCALATION_SG"/>
        </bpmn:startEvent>
        <bpmn:userTask id="Task_SM_Mediar" name="Mediación/coaching inmediato"/>
        <bpmn:endEvent id="EvSub_SM_End"/>
        <bpmn:sequenceFlow id="F_SM_ES1" sourceRef="EvSub_SM_Escalation" targetRef="Task_SM_Mediar"/>
        <bpmn:sequenceFlow id="F_SM_ES2" sourceRef="Task_SM_Mediar" targetRef="EvSub_SM_End"/>
      </bpmn:subProcess>
    </bpmn:subProcess>

    <bpmn:sendTask id="Task_SM_InvitarReview" name="Invitar a Review (PO/DEVs)">
      <bpmn:messageRef>MSG_REVIEW_INVITE</bpmn:messageRef>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="Ev_SM_RetroReport" attachedToRef="Task_SM_InvitarReview" cancelActivity="false" name="Reporte SG listo">
      <bpmn:messageEventDefinition messageRef="MSG_RETRO_REPORT"/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_SM_PreRetro" name="Preparar Retro con insights SG"/>
    <bpmn:userTask id="Task_SM_Retro" name="Facilitar Retrospective Social"/>
    <bpmn:endEvent id="Ev_SM_End" name="Cierre SM"/>

    <bpmn:sequenceFlow id="SM_F1" sourceRef="Ev_SM_Kickoff" targetRef="GW_SM_Fork"/>
    <bpmn:sequenceFlow id="SM_F2" sourceRef="GW_SM_Fork" targetRef="Task_SM_Agenda"/>
    <bpmn:sequenceFlow id="SM_F3" sourceRef="GW_SM_Fork" targetRef="Task_SM_RiesgosBoard"/>
    <bpmn:sequenceFlow id="SM_F4" sourceRef="Task_SM_Agenda" targetRef="GW_SM_Join"/>
    <bpmn:sequenceFlow id="SM_F5" sourceRef="Task_SM_RiesgosBoard" targetRef="GW_SM_Join"/>
    <bpmn:sequenceFlow id="SM_F6" sourceRef="GW_SM_Join" targetRef="Task_SM_Planning"/>
    <bpmn:sequenceFlow id="SM_F7" sourceRef="Task_SM_Planning" targetRef="Sub_SM_Daily"/>
    <bpmn:sequenceFlow id="SM_F8" sourceRef="Sub_SM_Daily" targetRef="Task_SM_InvitarReview"/>
    <bpmn:sequenceFlow id="SM_F9" sourceRef="Task_SM_InvitarReview" targetRef="Task_SM_PreRetro"/>
    <bpmn:sequenceFlow id="SM_F10" sourceRef="Task_SM_PreRetro" targetRef="Task_SM_Retro"/>
    <bpmn:sequenceFlow id="SM_F11" sourceRef="Task_SM_Retro" targetRef="Ev_SM_End"/>
  </bpmn:process>

  <!-- Proceso: SOCIAL GUIDE -->
  <bpmn:process id="Proc_SG" name="SG - Monitoreo & Intervención" isExecutable="false">
    <bpmn:startEvent id="Ev_SG_Start" name="Inicio Sprint"/>
    <bpmn:userTask id="Task_SG_Instrumentar" name="Instrumentar medición (encuestas/bots/paneles)"/>
    <bpmn:dataStoreReference id="DS_SG_Metrics" name="Repositorio de métricas sociales"/>
    <bpmn:association id="Assoc_SG_DS" sourceRef="Task_SG_Instrumentar" targetRef="DS_SG_Metrics"/>

    <!-- Subproceso disparado por timer (diario) -->
    <bpmn:subProcess id="ESP_SG_Diario" name="Monitoreo diario" triggeredByEvent="true">
      <bpmn:startEvent id="Ev_SG_Timer" name="08:30">
        <bpmn:timerEventDefinition><bpmn:timeCycle>R/PT24H</bpmn:timeCycle></bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:scriptTask id="Task_SG_Capturar" name="Capturar datos (mood/clima/cohesión)"/>
      <bpmn:scriptTask id="Task_SG_Detectar" name="Detectar community smells"/>
      <bpmn:exclusiveGateway id="GW_SG_Severidad" name="¿Severidad alta?"/>
      <bpmn:sendTask id="Task_SG_Escalar" name="Escalar a SM">
        <bpmn:messageRef>MSG_ESCALATION_SG</bpmn:messageRef>
      </bpmn:sendTask>
      <bpmn:sendTask id="Task_SG_EmitirSenales" name="Emitir señales (SM/PO/DEVs)">
        <bpmn:messageRef>MSG_SIGNALS_DAILY</bpmn:messageRef>
      </bpmn:sendTask>
      <bpmn:endEvent id="Ev_SG_Diario_End" name="Cierre día"/>

      <bpmn:sequenceFlow id="SG_FD1" sourceRef="Ev_SG_Timer" targetRef="Task_SG_Capturar"/>
      <bpmn:sequenceFlow id="SG_FD2" sourceRef="Task_SG_Capturar" targetRef="Task_SG_Detectar"/>
      <bpmn:sequenceFlow id="SG_FD3" sourceRef="Task_SG_Detectar" targetRef="GW_SG_Severidad"/>
      <bpmn:sequenceFlow id="SG_FD4" sourceRef="GW_SG_Severidad" targetRef="Task_SG_Escalar">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${true}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SG_FD5" sourceRef="GW_SG_Severidad" targetRef="Task_SG_EmitirSenales">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${false}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SG_FD6" sourceRef="Task_SG_Escalar" targetRef="Task_SG_EmitirSenales"/>
      <bpmn:sequenceFlow id="SG_FD7" sourceRef="Task_SG_EmitirSenales" targetRef="Ev_SG_Diario_End"/>
    </bpmn:subProcess>

    <bpmn:userTask id="Task_SG_PrepararReporte" name="Consolidar métricas para Retro"/>
    <bpmn:sendTask id="Task_SG_EnviarReporte" name="Enviar reporte a SM">
      <bpmn:messageRef>MSG_RETRO_REPORT</bpmn:messageRef>
    </bpmn:sendTask>
    <bpmn:endEvent id="Ev_SG_End" name="Cierre SG"/>

    <bpmn:sequenceFlow id="SG_F1" sourceRef="Ev_SG_Start" targetRef="Task_SG_Instrumentar"/>
    <bpmn:sequenceFlow id="SG_F2" sourceRef="Task_SG_Instrumentar" targetRef="Task_SG_PrepararReporte"/>
    <bpmn:sequenceFlow id="SG_F3" sourceRef="Task_SG_PrepararReporte" targetRef="Task_SG_EnviarReporte"/>
    <bpmn:sequenceFlow id="SG_F4" sourceRef="Task_SG_EnviarReporte" targetRef="Ev_SG_End"/>
  </bpmn:process>

  <!-- Proceso: DEVELOPERS -->
  <bpmn:process id="Proc_DEV" name="DEVs - Entrega con DoD Social" isExecutable="false">
    <bpmn:startEvent id="Ev_DEV_Kickoff" name="Kickoff recibido">
      <bpmn:messageEventDefinition messageRef="MSG_SPRINT_KICKOFF"/>
    </bpmn:startEvent>
    <bpmn:dataStoreReference id="DS_SprintBacklog" name="Sprint Backlog Social"/>
    <bpmn:dataStoreReference id="DS_DoD_Social" name="Definición de Terminado (Social)"/>
    <bpmn:dataStoreReference id="DS_Inc_Social" name="Repositorio Incremento Social"/>

    <bpmn:receiveTask id="Task_DEV_RecibirSenales" name="Daily: recibir señales SG">
      <bpmn:messageRef>MSG_SIGNALS_DAILY</bpmn:messageRef>
    </bpmn:receiveTask>

    <!-- Subproceso por ítem -->
    <bpmn:subProcess id="Sub_DEV_Item" name="Implementar DEV_ACT">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>n</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Ev_DEV_TomarItem" name="Tomar ítem del SB"/>
      <bpmn:scriptTask id="Task_DEV_Desarrollo" name="Desarrollo/Configuración"/>
      <bpmn:userTask id="Task_DEV_RevPar" name="Revisión por pares / feedback social"/>
      <bpmn:exclusiveGateway id="GW_DEV_DoD" name="¿Cumple DoD Social?"/>
      <bpmn:userTask id="Task_DEV_Rework" name="Rework hasta cumplir DoD"/>
      <bpmn:endEvent id="Ev_DEV_ItemListo" name="Ítem listo"/>

      <bpmn:sequenceFlow id="DEV_S1" sourceRef="Ev_DEV_TomarItem" targetRef="Task_DEV_Desarrollo"/>
      <bpmn:sequenceFlow id="DEV_S2" sourceRef="Task_DEV_Desarrollo" targetRef="Task_DEV_RevPar"/>
      <bpmn:sequenceFlow id="DEV_S3" sourceRef="Task_DEV_RevPar" targetRef="GW_DEV_DoD"/>
      <bpmn:sequenceFlow id="DEV_S4" sourceRef="GW_DEV_DoD" targetRef="Task_DEV_Rework">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${false}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="DEV_S5" sourceRef="Task_DEV_Rework" targetRef="Task_DEV_RevPar"/>
      <bpmn:sequenceFlow id="DEV_S6" sourceRef="GW_DEV_DoD" targetRef="Ev_DEV_ItemListo">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${true}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- Impedimento social (mensaje del SM) -->
      <bpmn:boundaryEvent id="BE_DEV_Impedimento" attachedToRef="Task_DEV_Desarrollo" cancelActivity="false" name="Impedimento social">
        <bpmn:messageEventDefinition messageRef="MSG_IMPEDIMENTO"/>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="Task_DEV_ResolverImp" name="Resolver impedimento con SM"/>
      <bpmn:sequenceFlow id="DEV_S7" sourceRef="BE_DEV_Impedimento" targetRef="Task_DEV_ResolverImp"/>
      <bpmn:sequenceFlow id="DEV_S8" sourceRef="Task_DEV_ResolverImp" targetRef="Task_DEV_RevPar"/>
    </bpmn:subProcess>

    <bpmn:userTask id="Task_DEV_GenerarInc" name="Generar Incremento Social"/>
    <bpmn:association id="Assoc_DEV_Inc" sourceRef="Task_DEV_GenerarInc" targetRef="DS_Inc_Social"/>

    <bpmn:receiveTask id="Ev_DEV_ReviewInvite" name="Invitación Review (SM)">
      <bpmn:messageRef>MSG_REVIEW_INVITE</bpmn:messageRef>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_DEV_Presentar" name="Presentar Incremento en Review"/>
    <bpmn:endEvent id="Ev_DEV_End" name="Cierre DEVs"/>

    <bpmn:sequenceFlow id="DEV_F1" sourceRef="Ev_DEV_Kickoff" targetRef="Task_DEV_RecibirSenales"/>
    <bpmn:sequenceFlow id="DEV_F2" sourceRef="Task_DEV_RecibirSenales" targetRef="Sub_DEV_Item"/>
    <bpmn:sequenceFlow id="DEV_F3" sourceRef="Sub_DEV_Item" targetRef="Task_DEV_GenerarInc"/>
    <bpmn:sequenceFlow id="DEV_F4" sourceRef="Task_DEV_GenerarInc" targetRef="Ev_DEV_ReviewInvite"/>
    <bpmn:sequenceFlow id="DEV_F5" sourceRef="Ev_DEV_ReviewInvite" targetRef="Task_DEV_Presentar"/>
    <bpmn:sequenceFlow id="DEV_F6" sourceRef="Task_DEV_Presentar" targetRef="Ev_DEV_End"/>
  </bpmn:process>

  <!-- DIAGRAM -->
  <bpmndi:BPMNDiagram id="DI_Master">
    <bpmndi:BPMNPlane id="Plane_Master" bpmnElement="Collab_Master">
      <!-- Pools -->
      <bpmndi:BPMNShape id="DI_PO" bpmnElement="Part_PO" isHorizontal="true"><dc:Bounds x="120" y="60" width="2300" height="300"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_SM" bpmnElement="Part_SM" isHorizontal="true"><dc:Bounds x="120" y="370" width="2300" height="320"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_SG" bpmnElement="Part_SG" isHorizontal="true"><dc:Bounds x="120" y="710" width="2300" height="300"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_DEV" bpmnElement="Part_DEV" isHorizontal="true"><dc:Bounds x="120" y="1020" width="2300" height="320"/></bpmndi:BPMNShape>

      <!-- (Opcional) Para mantener el archivo compacto, no se dibujan todos los DI internos; bpmn.io renderiza correctamente con estos bounds. -->
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
