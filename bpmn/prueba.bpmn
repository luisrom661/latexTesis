<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   id="Definitions_SocialScrum_Overview"
                   targetNamespace="http://bpmn.io/schema/bpmn">
  
  <bpmn:collaboration id="Collaboration_SocialScrum">
    <bpmn:participant id="Participant_SocialScrum" name="Proceso SocialScrum - Visión General del Ciclo de Sprint" processRef="Process_SocialScrum"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_SocialScrum" isExecutable="false">
    
    <!-- INICIO DEL SPRINT -->
    <bpmn:startEvent id="StartEvent_Sprint" name="Inicio del Sprint">
      <bpmn:outgoing>Flow_to_planning</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- ARTEFACTO: Product Backlog Social -->
    <bpmn:dataObjectReference id="DataObject_ProductBacklog" name="Product Backlog Social" dataObjectRef="DataObject_PB"/>
    <bpmn:dataObject id="DataObject_PB"/>
    
    <!-- 1. SPRINT PLANNING SOCIAL -->
    <bpmn:task id="Task_SprintPlanning" name="Sprint Planning Social&#10;⚠️ Social Guide revisa riesgos sociales&#10;• PO presenta ítems&#10;• Equipo crea Sprint Backlog">
      <bpmn:incoming>Flow_to_planning</bpmn:incoming>
      <bpmn:outgoing>Flow_to_daily</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_PB">
        <bpmn:sourceRef>DataObject_ProductBacklog</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_SB">
        <bpmn:targetRef>DataObject_SprintBacklog</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    
    <!-- ARTEFACTO: Sprint Backlog Social -->
    <bpmn:dataObjectReference id="DataObject_SprintBacklog" name="Sprint Backlog Social&#10;(técnico + social)" dataObjectRef="DataObject_SB"/>
    <bpmn:dataObject id="DataObject_SB"/>
    
    <!-- 2. DAILY SOCIAL SCRUM (SIMPLIFICADO) -->
    <bpmn:task id="Task_DailyScrum" name="Daily Social Scrum&#10;👥 Identificación de impedimentos sociales&#10;• Inspección de progreso&#10;• Social Guide facilita">
      <bpmn:incoming>Flow_to_daily</bpmn:incoming>
      <bpmn:outgoing>Flow_to_review</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_SB">
        <bpmn:sourceRef>DataObject_SprintBacklog</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_CS">
        <bpmn:targetRef>DataObject_CommunitySmells</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    
    <!-- ARTEFACTO: Registro de Community Smells -->
    <bpmn:dataObjectReference id="DataObject_CommunitySmells" name="Registro de&#10;Community Smells 🔍" dataObjectRef="DataObject_CS"/>
    <bpmn:dataObject id="DataObject_CS"/>
    
    <!-- NOTA: Ciclo diario -->
    <bpmn:textAnnotation id="Annotation_Daily">
      <bpmn:text>Se repite diariamente durante el Sprint</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Daily" sourceRef="Task_DailyScrum" targetRef="Annotation_Daily"/>
    
    <!-- 3. SPRINT REVIEW SOCIAL -->
    <bpmn:task id="Task_SprintReview" name="Sprint Review Social&#10;📊 Social Guide presenta dinámica del equipo&#10;• Demostración del incremento&#10;• Revisión con stakeholders">
      <bpmn:incoming>Flow_to_review</bpmn:incoming>
      <bpmn:outgoing>Flow_to_retro</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Inc">
        <bpmn:targetRef>DataObject_Increment</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    
    <!-- ARTEFACTO: Incremento + Evaluación Social -->
    <bpmn:dataObjectReference id="DataObject_Increment" name="Incremento +&#10;Evaluación de&#10;Salud Social" dataObjectRef="DataObject_Inc"/>
    <bpmn:dataObject id="DataObject_Inc"/>
    
    <!-- 4. SPRINT RETROSPECTIVE SOCIAL -->
    <bpmn:task id="Task_SprintRetro" name="Sprint Retrospective Social&#10;🔍 Social Guide analiza community smells&#10;• Scrum Master facilita&#10;• Equipo crea plan de mejora integral">
      <bpmn:incoming>Flow_to_retro</bpmn:incoming>
      <bpmn:outgoing>Flow_to_end</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_CS">
        <bpmn:sourceRef>DataObject_CommunitySmells</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_AP">
        <bpmn:targetRef>DataObject_ActionPlan</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    
    <!-- ARTEFACTO: Plan de Acción -->
    <bpmn:dataObjectReference id="DataObject_ActionPlan" name="Plan de Acción&#10;(mejoras técnicas&#10;+ sociales)" dataObjectRef="DataObject_AP"/>
    <bpmn:dataObject id="DataObject_AP"/>
    
    <!-- FIN DEL SPRINT -->
    <bpmn:endEvent id="EndEvent_Sprint" name="Cierre del Sprint /&#10;Inicio del siguiente">
      <bpmn:incoming>Flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- FLUJO DE RETROALIMENTACIÓN AL SIGUIENTE SPRINT -->
    <bpmn:textAnnotation id="Annotation_Cycle">
      <bpmn:text>El plan de acción alimenta el Product Backlog del siguiente Sprint</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Cycle" sourceRef="DataObject_ActionPlan" targetRef="Annotation_Cycle"/>
    
    <!-- FLUJOS PRINCIPALES -->
    <bpmn:sequenceFlow id="Flow_to_planning" sourceRef="StartEvent_Sprint" targetRef="Task_SprintPlanning"/>
    <bpmn:sequenceFlow id="Flow_to_daily" sourceRef="Task_SprintPlanning" targetRef="Task_DailyScrum"/>
    <bpmn:sequenceFlow id="Flow_to_review" sourceRef="Task_DailyScrum" targetRef="Task_SprintReview"/>
    <bpmn:sequenceFlow id="Flow_to_retro" sourceRef="Task_SprintReview" targetRef="Task_SprintRetro"/>
    <bpmn:sequenceFlow id="Flow_to_end" sourceRef="Task_SprintRetro" targetRef="EndEvent_Sprint"/>
    
  </bpmn:process>
  
  <!-- DIAGRAMA (Layout optimizado para visión general) -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_SocialScrum">
    <bpmndi:BPMNPlane id="BPMNPlane_SocialScrum" bpmnElement="Collaboration_SocialScrum">
      
      <!-- Pool principal -->
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_SocialScrum" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1620" height="500"/>
      </bpmndi:BPMNShape>
      
      <!-- EVENTOS Y TAREAS PRINCIPALES -->
      
      <!-- Inicio -->
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_Sprint">
        <dc:Bounds x="182" y="282" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="325" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Sprint Planning -->
      <bpmndi:BPMNShape id="Shape_Planning" bpmnElement="Task_SprintPlanning">
        <dc:Bounds x="280" y="240" width="140" height="120"/>
      </bpmndi:BPMNShape>
      
      <!-- Daily Scrum -->
      <bpmndi:BPMNShape id="Shape_Daily" bpmnElement="Task_DailyScrum">
        <dc:Bounds x="480" y="240" width="140" height="120"/>
      </bpmndi:BPMNShape>
      
      <!-- Sprint Review -->
      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Task_SprintReview">
        <dc:Bounds x="680" y="240" width="140" height="120"/>
      </bpmndi:BPMNShape>
      
      <!-- Sprint Retrospective -->
      <bpmndi:BPMNShape id="Shape_Retro" bpmnElement="Task_SprintRetro">
        <dc:Bounds x="880" y="240" width="140" height="120"/>
      </bpmndi:BPMNShape>
      
      <!-- Fin -->
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_Sprint">
        <dc:Bounds x="1072" y="282" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1048" y="325" width="84" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- DATA OBJECTS -->
      
      <!-- Product Backlog -->
      <bpmndi:BPMNShape id="Shape_Data_PB" bpmnElement="DataObject_ProductBacklog">
        <dc:Bounds x="332" y="130" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="306" y="100" width="88" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Sprint Backlog -->
      <bpmndi:BPMNShape id="Shape_Data_SB" bpmnElement="DataObject_SprintBacklog">
        <dc:Bounds x="382" y="420" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="356" y="477" width="88" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Community Smells -->
      <bpmndi:BPMNShape id="Shape_Data_CS" bpmnElement="DataObject_CommunitySmells">
        <dc:Bounds x="532" y="420" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="506" y="477" width="88" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Incremento -->
      <bpmndi:BPMNShape id="Shape_Data_Inc" bpmnElement="DataObject_Increment">
        <dc:Bounds x="732" y="420" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="706" y="477" width="88" height="53"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Plan de Acción -->
      <bpmndi:BPMNShape id="Shape_Data_AP" bpmnElement="DataObject_ActionPlan">
        <dc:Bounds x="982" y="420" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="956" y="477" width="88" height="53"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- ANOTACIONES -->
      
      <!-- Anotación Daily -->
      <bpmndi:BPMNShape id="Shape_Annotation_Daily" bpmnElement="Annotation_Daily">
        <dc:Bounds x="500" y="140" width="100" height="60"/>
      </bpmndi:BPMNShape>
      
      <!-- Anotación Ciclo -->
      <bpmndi:BPMNShape id="Shape_Annotation_Cycle" bpmnElement="Annotation_Cycle">
        <dc:Bounds x="1120" y="415" width="160" height="60"/>
      </bpmndi:BPMNShape>
      
      <!-- EDGES (Flujos) -->
      
      <bpmndi:BPMNEdge id="Edge_to_planning" bpmnElement="Flow_to_planning">
        <di:waypoint x="218" y="300"/>
        <di:waypoint x="280" y="300"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_to_daily" bpmnElement="Flow_to_daily">
        <di:waypoint x="420" y="300"/>
        <di:waypoint x="480" y="300"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_to_review" bpmnElement="Flow_to_review">
        <di:waypoint x="620" y="300"/>
        <di:waypoint x="680" y="300"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_to_retro" bpmnElement="Flow_to_retro">
        <di:waypoint x="820" y="300"/>
        <di:waypoint x="880" y="300"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_to_end" bpmnElement="Flow_to_end">
        <di:waypoint x="1020" y="300"/>
        <di:waypoint x="1072" y="300"/>
      </bpmndi:BPMNEdge>
      
      <!-- Asociaciones de anotaciones -->
      
      <bpmndi:BPMNEdge id="Edge_Assoc_Daily" bpmnElement="Association_Daily">
        <di:waypoint x="550" y="240"/>
        <di:waypoint x="550" y="200"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Assoc_Cycle" bpmnElement="Association_Cycle">
        <di:waypoint x="1018" y="445"/>
        <di:waypoint x="1120" y="445"/>
      </bpmndi:BPMNEdge>
      
      <!-- Data Input/Output edges (visuales) -->
      
      <bpmndi:BPMNEdge id="Edge_Data_PB" bpmnElement="DataInputAssociation_PB">
        <di:waypoint x="350" y="180"/>
        <di:waypoint x="350" y="240"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Data_SB_Out" bpmnElement="DataOutputAssociation_SB">
        <di:waypoint x="400" y="360"/>
        <di:waypoint x="400" y="420"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Data_SB_In" bpmnElement="DataInputAssociation_SB">
        <di:waypoint x="418" y="420"/>
        <di:waypoint x="500" y="360"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Data_CS" bpmnElement="DataOutputAssociation_CS">
        <di:waypoint x="550" y="360"/>
        <di:waypoint x="550" y="420"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Data_Inc" bpmnElement="DataOutputAssociation_Inc">
        <di:waypoint x="750" y="360"/>
        <di:waypoint x="750" y="420"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Data_CS_In" bpmnElement="DataInputAssociation_CS">
        <di:waypoint x="568" y="420"/>
        <di:waypoint x="900" y="360"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Data_AP" bpmnElement="DataOutputAssociation_AP">
        <di:waypoint x="1000" y="360"/>
        <di:waypoint x="1000" y="420"/>
      </bpmndi:BPMNEdge>
      
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  
</bpmn:definitions>