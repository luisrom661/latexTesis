<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Defs_DEV" targetNamespace="http://example.com/socialscrum/dev">

  <bpmn:message id="MSG_SPRINT_KICKOFF" name="Sprint Kickoff (SM/PO→DEVs)"/>
  <bpmn:message id="MSG_SIGNALS_DAILY" name="Señales Sociales (SG→DEVs)"/>
  <bpmn:message id="MSG_REVIEW_INVITE" name="Invitación Review (SM→DEVs)"/>
  <bpmn:message id="MSG_IMPEDIMENTO" name="Impedimento Social (SM→DEVs)"/>

  <bpmn:collaboration id="Collab_DEV">
    <bpmn:participant id="Part_DEV" name="Developers" processRef="Proc_DEV"/>
    <bpmn:participant id="Part_SM" name="Scrum Master"/>
    <bpmn:participant id="Part_PO" name="Product Owner"/>
    <bpmn:participant id="Part_SG" name="Social Guide"/>

    <bpmn:messageFlow id="MF_Kickoff_DEV" sourceRef="Ev_Kickoff" targetRef="Part_SM" messageRef="MSG_SPRINT_KICKOFF"/>
    <bpmn:messageFlow id="MF_Signals_DEV" sourceRef="Task_DEV_RecibirSenales" targetRef="Part_SG" messageRef="MSG_SIGNALS_DAILY"/>
    <bpmn:messageFlow id="MF_Review_DEV" sourceRef="Ev_ReviewInvite" targetRef="Part_SM" messageRef="MSG_REVIEW_INVITE"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_DEV" name="Entrega con DoD Social (DEVs)" isExecutable="false">
    <bpmn:startEvent id="Ev_Kickoff" name="Kickoff recibido">
      <bpmn:messageEventDefinition messageRef="MSG_SPRINT_KICKOFF"/>
    </bpmn:startEvent>

    <bpmn:dataStoreReference id="DS_SprintBacklog" name="Sprint Backlog Social"/>
    <bpmn:dataStoreReference id="DS_DoD" name="Definición de Terminado (Social)"/>
    <bpmn:dataStoreReference id="DS_Inc" name="Repositorio Incremento Social"/>

    <bpmn:receiveTask id="Task_DEV_RecibirSenales" name="Daily: recibir señales SG">
      <bpmn:messageRef>MSG_SIGNALS_DAILY</bpmn:messageRef>
    </bpmn:receiveTask>

    <!-- Subproceso por ítem -->
    <bpmn:subProcess id="Sub_Item" name="Implementar ítem DEV_ACT">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>n</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="Ev_TomarItem" name="Tomar ítem del SB"/>
      <bpmn:scriptTask id="Task_Dev" name="Desarrollo/Configuración"/>
      <bpmn:userTask id="Task_RevPar" name="Revisión por pares / feedback social"/>
      <bpmn:exclusiveGateway id="GW_DoD" name="¿Cumple DoD Social?"/>
      <bpmn:userTask id="Task_Rework" name="Rework hasta cumplir DoD"/>
      <bpmn:endEvent id="Ev_ItemListo" name="Ítem listo"/>

      <bpmn:sequenceFlow id="S1" sourceRef="Ev_TomarItem" targetRef="Task_Dev"/>
      <bpmn:sequenceFlow id="S2" sourceRef="Task_Dev" targetRef="Task_RevPar"/>
      <bpmn:sequenceFlow id="S3" sourceRef="Task_RevPar" targetRef="GW_DoD"/>
      <bpmn:sequenceFlow id="S4" sourceRef="GW_DoD" targetRef="Task_Rework">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${false}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="S5" sourceRef="Task_Rework" targetRef="Task_RevPar"/>
      <bpmn:sequenceFlow id="S6" sourceRef="GW_DoD" targetRef="Ev_ItemListo">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${true}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- boundary message: impedimento social -->
      <bpmn:boundaryEvent id="BE_Impedimento" attachedToRef="Task_Dev" cancelActivity="false" name="Impedimento social">
        <bpmn:messageEventDefinition messageRef="MSG_IMPEDIMENTO"/>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="Task_ResolverImp" name="Resolver impedimento con SM"/>
      <bpmn:sequenceFlow id="S7" sourceRef="BE_Impedimento" targetRef="Task_ResolverImp"/>
      <bpmn:sequenceFlow id="S8" sourceRef="Task_ResolverImp" targetRef="Task_RevPar"/>
    </bpmn:subProcess>

    <bpmn:userTask id="Task_GenerarInc" name="Generar Incremento Social"/>
    <bpmn:association id="Assoc_Inc" sourceRef="Task_GenerarInc" targetRef="DS_Inc"/>

    <bpmn:receiveTask id="Ev_ReviewInvite" name="Invitación Review (SM)">
      <bpmn:messageRef>MSG_REVIEW_INVITE</bpmn:messageRef>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_Presentar" name="Presentar Incremento en Review"/>
    <bpmn:userTask id="Task_AplicarAcciones" name="Aplicar acciones de mejora (post-Retro)"/>
    <bpmn:endEvent id="Ev_End" name="Cierre / Próximo Sprint"/>

    <!-- FLUJO -->
    <bpmn:sequenceFlow id="F1" sourceRef="Ev_Kickoff" targetRef="Task_DEV_RecibirSenales"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_DEV_RecibirSenales" targetRef="Sub_Item"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Sub_Item" targetRef="Task_GenerarInc"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_GenerarInc" targetRef="Ev_ReviewInvite"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Ev_ReviewInvite" targetRef="Task_Presentar"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Presentar" targetRef="Task_AplicarAcciones"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_AplicarAcciones" targetRef="Ev_End"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="DI_DEV">
    <bpmndi:BPMNPlane id="Plane_DEV" bpmnElement="Collab_DEV">
      <bpmndi:BPMNShape id="DI_Part_DEV" bpmnElement="Part_DEV" isHorizontal="true"><dc:Bounds x="150" y="60" width="1750" height="330"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_SM" bpmnElement="Part_SM" isHorizontal="true"><dc:Bounds x="150" y="400" width="1750" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_PO" bpmnElement="Part_PO" isHorizontal="true"><dc:Bounds x="150" y="480" width="1750" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_SG" bpmnElement="Part_SG" isHorizontal="true"><dc:Bounds x="150" y="560" width="1750" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DI_EvKick" bpmnElement="Ev_Kickoff"><dc:Bounds x="180" y="200" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskRecSig" bpmnElement="Task_DEV_RecibirSenales"><dc:Bounds x="240" y="180" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_SubItem" bpmnElement="Sub_Item"><dc:Bounds x="520" y="120" width="620" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskInc" bpmnElement="Task_GenerarInc"><dc:Bounds x="1160" y="180" width="240" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_EvInv" bpmnElement="Ev_ReviewInvite"><dc:Bounds x="1410" y="196" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskPres" bpmnElement="Task_Presentar"><dc:Bounds x="1460" y="180" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskApply" bpmnElement="Task_AplicarAcciones"><dc:Bounds x="1730" y="180" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End" bpmnElement="Ev_End"><dc:Bounds x="2000" y="196" width="36" height="36"/></bpmndi:BPMNShape>

      <!-- Sub_Item internals -->
      <bpmndi:BPMNShape id="DI_EvTake" bpmnElement="Ev_TomarItem"><dc:Bounds x="540" y="170" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskDev" bpmnElement="Task_Dev"><dc:Bounds x="590" y="160" width="200" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskRev" bpmnElement="Task_RevPar"><dc:Bounds x="800" y="160" width="210" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GWDoD" bpmnElement="GW_DoD"><dc:Bounds x="840" y="215" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskRework" bpmnElement="Task_Rework"><dc:Bounds x="890" y="215" width="210" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_EvItem" bpmnElement="Ev_ItemListo"><dc:Bounds x="1110" y="223" width="28" height="28"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_BEImp" bpmnElement="BE_Impedimento"><dc:Bounds x="670" y="190" width="28" height="28"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskResImp" bpmnElement="Task_ResolverImp"><dc:Bounds x="700" y="215" width="130" height="50"/></bpmndi:BPMNShape>

      <!-- Data stores -->
      <bpmndi:BPMNShape id="DI_DS_SB" bpmnElement="DS_SprintBacklog"><dc:Bounds x="520" y="330" width="55" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_DS_DoD" bpmnElement="DS_DoD"><dc:Bounds x="710" y="330" width="55" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_DS_Inc" bpmnElement="DS_Inc"><dc:Bounds x="1180" y="250" width="55" height="40"/></bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_F1" bpmnElement="F1"><di:waypoint x="216" y="218"/><di:waypoint x="240" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2" bpmnElement="F2"><di:waypoint x="500" y="210"/><di:waypoint x="520" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3" bpmnElement="F3"><di:waypoint x="1140" y="210"/><di:waypoint x="1160" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4" bpmnElement="F4"><di:waypoint x="1400" y="210"/><di:waypoint x="1410" y="214"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F5" bpmnElement="F5"><di:waypoint x="1446" y="214"/><di:waypoint x="1460" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F6" bpmnElement="F6"><di:waypoint x="1710" y="210"/><di:waypoint x="1730" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F7" bpmnElement="F7"><di:waypoint x="1990" y="210"/><di:waypoint x="2000" y="214"/></bpmndi:BPMNEdge>

      <!-- Sub edges -->
      <bpmndi:BPMNEdge id="E_S1" bpmnElement="S1"><di:waypoint x="576" y="188"/><di:waypoint x="590" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S2" bpmnElement="S2"><di:waypoint x="790" y="185"/><di:waypoint x="800" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S3" bpmnElement="S3"><di:waypoint x="910" y="185"/><di:waypoint x="860" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S4" bpmnElement="S4"><di:waypoint x="880" y="235"/><di:waypoint x="890" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S5" bpmnElement="S5"><di:waypoint x="1100" y="240"/><di:waypoint x="1010" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S6" bpmnElement="S6"><di:waypoint x="860" y="235"/><di:waypoint x="1110" y="237"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S7" bpmnElement="S7"><di:waypoint x="684" y="204"/><di:waypoint x="700" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S8" bpmnElement="S8"><di:waypoint x="830" y="240"/><di:waypoint x="800" y="185"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
