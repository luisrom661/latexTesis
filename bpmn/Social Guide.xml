<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Defs_SG" targetNamespace="http://example.com/socialscrum/sg">

  <bpmn:message id="MSG_SIGNALS_DAILY" name="Señales Sociales (SG→SM/PO/DEVs)"/>
  <bpmn:message id="MSG_ESCALATION_SG" name="Escalación Social (SG→SM)"/>
  <bpmn:message id="MSG_RETRO_REPORT" name="Reporte Retro (SG→SM)"/>

  <bpmn:collaboration id="Collab_SG">
    <bpmn:participant id="Part_SG" name="Social Guide" processRef="Proc_SG"/>
    <bpmn:participant id="Part_SM" name="Scrum Master"/>
    <bpmn:participant id="Part_PO" name="Product Owner"/>
    <bpmn:participant id="Part_DEV" name="Developers"/>

    <bpmn:messageFlow id="MF_Signals_SM" sourceRef="Task_SG_EmitirSenales" targetRef="Part_SM" messageRef="MSG_SIGNALS_DAILY"/>
    <bpmn:messageFlow id="MF_Signals_PO" sourceRef="Task_SG_EmitirSenales" targetRef="Part_PO" messageRef="MSG_SIGNALS_DAILY"/>
    <bpmn:messageFlow id="MF_Signals_DEV" sourceRef="Task_SG_EmitirSenales" targetRef="Part_DEV" messageRef="MSG_SIGNALS_DAILY"/>
    <bpmn:messageFlow id="MF_Escal_SM" sourceRef="Task_SG_Escalar" targetRef="Part_SM" messageRef="MSG_ESCALATION_SG"/>
    <bpmn:messageFlow id="MF_Report_SM" sourceRef="Task_SG_EnviarReporte" targetRef="Part_SM" messageRef="MSG_RETRO_REPORT"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_SG" name="Monitoreo y Mejora Social (SG)" isExecutable="false">
    <bpmn:startEvent id="Ev_Start" name="Inicio Sprint"/>
    <bpmn:userTask id="Task_SG_Instrumentar" name="Instrumentar: encuestas, bots, csDetector, paneles"/>
    <bpmn:dataStoreReference id="DS_Metrics" name="Repositorio de métricas sociales"/>
    <bpmn:association id="Assoc_DS" sourceRef="Task_SG_Instrumentar" targetRef="DS_Metrics"/>

    <!-- EVENT SUB-PROCESS: monitoreo continuo diario -->
    <bpmn:subProcess id="ESP_Monitoreo" name="Monitoreo continuo" triggeredByEvent="true">
      <bpmn:startEvent id="Ev_Timer" name="Cada día 08:30"><bpmn:timerEventDefinition><bpmn:timeCycle>R/PT24H</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
      <bpmn:scriptTask id="Task_SG_Capturar" name="Capturar datos (mood/clima/cohesión)"/>
      <bpmn:scriptTask id="Task_SG_Detectar" name="Detectar community smells"/>
      <bpmn:exclusiveGateway id="GW_Severidad" name="¿Severidad alta?"/>
      <bpmn:sendTask id="Task_SG_Escalar" name="Escalar a SM"><bpmn:messageRef>MSG_ESCALATION_SG</bpmn:messageRef></bpmn:sendTask>
      <bpmn:sendTask id="Task_SG_EmitirSenales" name="Emitir señales a SM/PO/DEVs"><bpmn:messageRef>MSG_SIGNALS_DAILY</bpmn:messageRef></bpmn:sendTask>
      <bpmn:endEvent id="Ev_Mon_End" name="Fin del día"/>

      <bpmn:sequenceFlow id="FM1" sourceRef="Ev_Timer" targetRef="Task_SG_Capturar"/>
      <bpmn:sequenceFlow id="FM2" sourceRef="Task_SG_Capturar" targetRef="Task_SG_Detectar"/>
      <bpmn:sequenceFlow id="FM3" sourceRef="Task_SG_Detectar" targetRef="GW_Severidad"/>
      <bpmn:sequenceFlow id="FM4" sourceRef="GW_Severidad" targetRef="Task_SG_Escalar">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${true}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="FM5" sourceRef="GW_Severidad" targetRef="Task_SG_EmitirSenales">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${false}]]></bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="FM6" sourceRef="Task_SG_Escalar" targetRef="Task_SG_EmitirSenales"/>
      <bpmn:sequenceFlow id="FM7" sourceRef="Task_SG_EmitirSenales" targetRef="Ev_Mon_End"/>
    </bpmn:subProcess>

    <bpmn:userTask id="Task_SG_PrepararReporte" name="Consolidar métricas e insights para Retro"/>
    <bpmn:sendTask id="Task_SG_EnviarReporte" name="Enviar reporte a SM"><bpmn:messageRef>MSG_RETRO_REPORT</bpmn:messageRef></bpmn:sendTask>
    <bpmn:endEvent id="Ev_End" name="Cierre / Próximo Sprint"/>

    <bpmn:sequenceFlow id="F1" sourceRef="Ev_Start" targetRef="Task_SG_Instrumentar"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_SG_Instrumentar" targetRef="Task_SG_PrepararReporte"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_SG_PrepararReporte" targetRef="Task_SG_EnviarReporte"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_SG_EnviarReporte" targetRef="Ev_End"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="DI_SG">
    <bpmndi:BPMNPlane id="Plane_SG" bpmnElement="Collab_SG">
      <bpmndi:BPMNShape id="DI_Part_SG" bpmnElement="Part_SG" isHorizontal="true"><dc:Bounds x="150" y="60" width="1650" height="330"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_SM" bpmnElement="Part_SM" isHorizontal="true"><dc:Bounds x="150" y="400" width="1650" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_PO" bpmnElement="Part_PO" isHorizontal="true"><dc:Bounds x="150" y="480" width="1650" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_DEV" bpmnElement="Part_DEV" isHorizontal="true"><dc:Bounds x="150" y="560" width="1650" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DI_EvStart" bpmnElement="Ev_Start"><dc:Bounds x="180" y="200" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskInst" bpmnElement="Task_SG_Instrumentar"><dc:Bounds x="240" y="180" width="360" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_DS" bpmnElement="DS_Metrics"><dc:Bounds x="300" y="250" width="55" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ESP" bpmnElement="ESP_Monitoreo"><dc:Bounds x="620" y="120" width="620" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskPrep" bpmnElement="Task_SG_PrepararReporte"><dc:Bounds x="1260" y="180" width="300" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskSend" bpmnElement="Task_SG_EnviarReporte"><dc:Bounds x="1580" y="180" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End" bpmnElement="Ev_End"><dc:Bounds x="1850" y="196" width="36" height="36"/></bpmndi:BPMNShape>

      <!-- inside ESP -->
      <bpmndi:BPMNShape id="DI_EvTimer" bpmnElement="Ev_Timer"><dc:Bounds x="640" y="170" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskCap" bpmnElement="Task_SG_Capturar"><dc:Bounds x="690" y="160" width="220" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskDet" bpmnElement="Task_SG_Detectar"><dc:Bounds x="920" y="160" width="220" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GWSev" bpmnElement="GW_Severidad"><dc:Bounds x="870" y="215" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskEsc" bpmnElement="Task_SG_Escalar"><dc:Bounds x="930" y="215" width="200" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_TaskEmit" bpmnElement="Task_SG_EmitirSenales"><dc:Bounds x="1140" y="215" width="220" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_MonEnd" bpmnElement="Ev_Mon_End"><dc:Bounds x="1370" y="223" width="28" height="28"/></bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_F1" bpmnElement="F1"><di:waypoint x="216" y="218"/><di:waypoint x="240" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2" bpmnElement="F2"><di:waypoint x="600" y="210"/><di:waypoint x="1260" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3" bpmnElement="F3"><di:waypoint x="1560" y="210"/><di:waypoint x="1580" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4" bpmnElement="F4"><di:waypoint x="1840" y="210"/><di:waypoint x="1850" y="214"/></bpmndi:BPMNEdge>

      <!-- ESP edges -->
      <bpmndi:BPMNEdge id="E_FM1" bpmnElement="FM1"><di:waypoint x="676" y="188"/><di:waypoint x="690" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FM2" bpmnElement="FM2"><di:waypoint x="910" y="185"/><di:waypoint x="920" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FM3" bpmnElement="FM3"><di:waypoint x="1030" y="185"/><di:waypoint x="890" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FM4" bpmnElement="FM4"><di:waypoint x="910" y="235"/><di:waypoint x="930" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FM5" bpmnElement="FM5"><di:waypoint x="890" y="235"/><di:waypoint x="1140" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FM6" bpmnElement="FM6"><di:waypoint x="1130" y="240"/><di:waypoint x="1140" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FM7" bpmnElement="FM7"><di:waypoint x="1360" y="240"/><di:waypoint x="1370" y="237"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
