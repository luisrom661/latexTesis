graph LR
    %% ═══════════════════════════════════════════════════
    %%  El Ciclo Sociotécnico — SocialScrum
    %%  Fuente: Elaboración propia
    %% ═══════════════════════════════════════════════════

    classDef scrumEvent fill:#2980B9,stroke:#1A5276,stroke-width:2px,color:#FFFFFF,font-weight:bold
    classDef sprint fill:#E67E22,stroke:#BA4A00,stroke-width:2px,color:#FFFFFF,font-weight:bold
    classDef socialLayer fill:#1ABC9C,stroke:#0E6655,stroke-width:2px,color:#FFFFFF,font-style:italic
    classDef escudo fill:#E74C3C,stroke:#922B21,stroke-width:3px,color:#FFFFFF,font-weight:bold
    classDef artefacto fill:#F9E79F,stroke:#B7950B,stroke-width:1.5px,color:#2C3E50

    %% ══════════════════════════════════════════
    %%  PRINCIPIO DE NO-SOBRECARGA (Escudo)
    %% ══════════════════════════════════════════
    subgraph ESCUDO["PRINCIPIO DE NO-SOBRECARGA"]
        direction TB
        E1["Reserva máxima: 10% — 20%<br/>de la capacidad del Sprint"]:::escudo
    end

    %% ══════════════════════════════════════════
    %%  CAPA ENVOLVENTE: SocialScrum
    %% ══════════════════════════════════════════
    subgraph SOCIAL["CAPA SOCIALSCRUM — Gestión social integrada al desarrollo"]
        direction LR

        SOC_L["Diagnóstico de<br/>Olores Comunitarios"]:::socialLayer
        SOC_R["Monitoreo de<br/>Confianza y SDT"]:::socialLayer

        %% ══════════════════════════════════════
        %%  NÚCLEO: Ciclo Scrum Tradicional
        %% ══════════════════════════════════════
        subgraph SCRUM["CICLO DE SPRINT"]
            direction LR
            PB["Product<br/>Backlog"]:::artefacto
            SP["Sprint<br/>Planning"]:::scrumEvent
            SB["Sprint<br/>Backlog"]:::artefacto
            DEV["Sprint en<br/>Ejecución"]:::sprint
            DAILY["Daily<br/>Scrum"]:::scrumEvent
            INC["Incremento"]:::artefacto
            REV["Sprint<br/>Review"]:::scrumEvent
            RETRO["Sprint<br/>Retrospective"]:::scrumEvent

            PB --> SP
            SP --> SB
            SB --> DEV
            DAILY -."cada día".-> DEV
            DEV --> INC
            INC --> REV
            REV --> RETRO
            RETRO -."mejora continua".-> PB
        end

        SOC_L -."observa".-> SCRUM
        SCRUM -."informa".-> SOC_R
    end

    ESCUDO -."limita la carga social".-> SOCIAL

    %% ── Estilos de subgrafos ──
    style ESCUDO fill:#FDEDEC,stroke:#922B21,stroke-width:3px,rx:6,ry:6
    style SOCIAL fill:#E8F8F5,stroke:#0E6655,stroke-width:2.5px,rx:4,ry:4,stroke-dasharray:8 4
    style SCRUM fill:#EBF5FB,stroke:#1A5276,stroke-width:2px,rx:4,ry:4
